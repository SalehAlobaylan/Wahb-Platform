# Environment Variables

# CMS API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
CMS_BASE_URL=http://localhost:8080/api/v1

# IAM API Configuration
IAM_API_URL=http://localhost:4003/api/v1
# Browser-side IAM base (used by client auth flows that call IAM directly).
NEXT_PUBLIC_IAM_BASE_URL=http://localhost:4003/api/v1

# Feature Flags
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=false

# Mobile app-link association (production deployment only). The Apple Team ID
# and release signing SHA-256 are obtained after Apple/EAS enrollment.
APPLE_APP_ID_PREFIX=
ANDROID_APP_LINK_CERT_SHA256=
